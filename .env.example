# oci-arm-catcher (Docker/CasaOS) configuration.
# Copy to .env, fill in, then: docker compose up -d --build
#
# Everything is passed to the container as environment variables.
# Run scripts/get-config.sh (with OCI CLI configured) to discover the OCIDs.

# ── OCI instance settings (required) ──────────────────────────────────────────
COMPARTMENT_ID="ocid1.tenancy.oc1..xxxx"
DISPLAY_NAME="arm-free-1"
AVAILABILITY_DOMAIN="Abcd:EU-AMSTERDAM-1-AD-1"
# Multi-AD regions: rotate across ADs (overrides AVAILABILITY_DOMAIN):
# AVAILABILITY_DOMAINS="Abcd:US-ASHBURN-1-AD-1,Abcd:US-ASHBURN-1-AD-2,Abcd:US-ASHBURN-1-AD-3"
SUBNET_ID="ocid1.subnet.oc1..xxxx"
IMAGE_ID="ocid1.image.oc1..xxxx"
OCPUS=2
MEMORY_GB=12
RETRY_INTERVAL=300

# ── SSH access to the instance (choose ONE) ───────────────────────────────────
# Option A - key content (easiest on CasaOS):
SSH_PUBLIC_KEY="ssh-ed25519 AAAA... you@example"
# Option B - mounted file (see docker-compose.yml), then:
# SSH_KEY_FILE=/keys/ssh.pub

# ── OCI authentication (choose ONE) ───────────────────────────────────────────
# Option A - mount ~/.oci/config + key (see docker-compose.yml). No env needed.
# Option B - full env auth (paste from your ~/.oci/config):
# OCI_CLI_CONFIG_FILE is only needed for a non-default mounted path:
# OCI_CLI_CONFIG_FILE=/root/.oci/config
# OCI_CLI_TENANCY="ocid1.tenancy.oc1..xxxx"
# OCI_CLI_USER="ocid1.user.oc1..xxxx"
# OCI_CLI_FINGERPRINT="aa:bb:cc:..."
# OCI_CLI_KEY_CONTENT="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
# OCI_CLI_REGION="eu-amsterdam-1"
# If the key has a passphrase:
# OCI_CLI_PASSPHRASE="..."

# ── Notifications (optional but recommended for 24/7 unattended) ─────────────
# Telegram: create a bot via @BotFather, get your chat id (e.g. via @userinfobot)
# TELEGRAM_BOT_TOKEN="123456:ABC-DEF..."
# TELEGRAM_CHAT_ID="123456789"

# ── Web UI ────────────────────────────────────────────────────────────────────
# Host port for the status/log page: http://<casaos-ip>:8090
WEB_PORT=8090
